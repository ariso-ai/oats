{
  "$comment": [
    "Claude Code settings for issue-autopilot.yml. Same purpose as",
    "claude-agent-settings.json (read the $comment there first) with one",
    "difference: the autopilot skill drives superpowers, which reads its own",
    "prompt templates and runs its own helper scripts out of",
    "~/.claude/plugins/cache/. The shared file's blanket Read(~/.claude/**)",
    "blocks both — Read denials also stop Bash commands that read a denied",
    "path — so this file denies the sensitive parts of ~/.claude one by one",
    "instead and leaves plugins/ readable.",
    "",
    "The autopilot agent has an unrestricted shell (bypassPermissions), so",
    "these rules are friction against casual or injected reads, not a",
    "boundary. The boundaries are listed at the top of issue-autopilot.yml."
  ],
  "permissions": {
    "deny": [
      "Read(~/.claude.json)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.claude/*.json)",
      "Read(~/.claude/*.jsonl)",
      "Read(~/.claude/projects/**)",
      "Read(~/.claude/shell-snapshots/**)",
      "Read(~/.claude/session-env/**)",
      "Read(~/.claude/file-history/**)",
      "Read(~/.claude/debug/**)",
      "Read(~/.claude/todos/**)",
      "Read(~/.claude/statsig/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.config/**)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.gitconfig)",
      "Read(~/.git-credentials)",
      "Read(~/Library/Keychains/**)",
      "Read(~/Library/Application Support/**)",
      "Read(~/actions-runner/**/.credentials*)",
      "Read(~/actions-runner/**/.env)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.p12)",
      "Read(**/*.key)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(.git/**)",

      "Write(~/.claude.json)",
      "Edit(~/.claude.json)",
      "Write(~/.claude/**)",
      "Edit(~/.claude/**)",
      "Write(.git/**)",
      "Edit(.git/**)",
      "Write(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Write(~/.zshrc)",
      "Edit(~/.zshrc)",
      "Write(~/.zprofile)",
      "Edit(~/.zprofile)",
      "Write(~/.bashrc)",
      "Edit(~/.bashrc)",
      "Write(~/.bash_profile)",
      "Edit(~/.bash_profile)",
      "Write(~/.gitconfig)",
      "Edit(~/.gitconfig)",
      "Write(~/Library/LaunchAgents/**)",
      "Edit(~/Library/LaunchAgents/**)"
    ]
  }
}
