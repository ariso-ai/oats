{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ariso-ai/oats/blob/main/src-tauri/ariso-stt/shared/transcript.schema.json",
  "title": "ariso-stt transcript output",
  "type": "object",
  "additionalProperties": false,
  "required": ["language", "durationSeconds", "participants", "segments"],
  "properties": {
    "language": {
      "type": "string"
    },
    "durationSeconds": {
      "type": "number",
      "minimum": 0
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 0
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["speaker", "text", "start", "end"],
        "properties": {
          "speaker": {
            "type": "integer",
            "minimum": 0
          },
          "text": {
            "type": "string"
          },
          "start": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    }
  }
}
